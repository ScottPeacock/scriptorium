--swiftversion 6.0
--exclude Resources/foliate,Scriptorium.xcodeproj
--indent 4
--maxwidth 120
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--closingparen balanced
--commas inline
--self remove
--stripunusedargs closure-only
--trimwhitespace always
# Conflicts with SwiftLint's opening_brace rule, which wants the brace on the
# same line as the condition. SwiftLint wins; keep conditions short instead.
--disable wrapMultilineStatementBraces
